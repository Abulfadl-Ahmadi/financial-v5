# Environment Variables for Financial ERP v5 Backend
# Copy this file to .env and adjust variables for your deployment

# Environment: 'development' or 'production'
DJANGO_ENV=development

# Debug mode: True for development, False for production
DJANGO_DEBUG=True

# Secret Key: in production, must be at least 50 characters, random and unique
DJANGO_SECRET_KEY=dev-secret-key-only-for-local-development-financial-v5-random-seed-phrase-not-for-prod

# Allowed Hosts: comma-separated list of hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins: comma-separated list of frontend URLs
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOW_ALL=True

# SSL & Security Flags (Active in production by default)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
